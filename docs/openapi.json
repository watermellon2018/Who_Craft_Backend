{
  "openapi": "3.0.3",
  "info": {
    "title": "W Craft API",
    "version": "1.0.0",
    "description": "Canonical contract for frontend-facing project, character tree and poster operations."
  },
  "servers": [
    {"url": "/"}
  ],
  "security": [
    {"userToken": []}
  ],
  "x-contract-constraints": {
    "posterPromptMaxLength": 1000,
    "projectAnnotationMaxLength": 800,
    "projectSynopsisMaxLength": 2000,
    "projectPosterMaxBytes": 5242880
  },
  "paths": {
    "/api/schema/openapi.json": {
      "get": {
        "operationId": "getOpenApiSchema",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI document",
            "content": {"application/json": {"schema": {"type": "object"}}}
          }
        }
      }
    },
    "/api/character/select/": {
      "get": {
        "operationId": "listCharacterTree",
        "parameters": [
          {
            "name": "projectId",
            "in": "query",
            "required": true,
            "schema": {"type": "integer"}
          }
        ],
        "responses": {
          "200": {
            "description": "Character tree",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {"$ref": "#/components/schemas/CharacterTreeNode"}
                }
              }
            }
          },
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/api/character/create/": {
      "post": {
        "operationId": "createCharacterTreeNode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CharacterTreeCreateRequest"}
            }
          }
        },
        "responses": {
          "200": {"description": "Tree node created"},
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/api/character/rename/": {
      "post": {
        "operationId": "renameCharacterTreeNode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CharacterTreeRenameRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tree node renamed",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/CharacterTreeRenameResponse"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/api/character/delete/": {
      "post": {
        "operationId": "deleteCharacterTreeNode",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/CharacterTreeDeleteRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tree node deleted",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/DeleteResponse"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/api/projects/{projectId}/poster/generate/": {
      "post": {
        "operationId": "generateProjectPoster",
        "parameters": [
          {"$ref": "#/components/parameters/ProjectId"},
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {"type": "string", "format": "uuid"}
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/PosterGenerateRequest"}
            },
            "multipart/form-data": {
              "schema": {"$ref": "#/components/schemas/PosterGenerateMultipartRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Idempotent replay",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/PosterOperationResponse"}
              }
            }
          },
          "201": {
            "description": "Poster generation accepted/completed",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/PosterOperationResponse"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "413": {"$ref": "#/components/responses/ApiError"},
          "415": {"$ref": "#/components/responses/ApiError"},
          "429": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/api/projects/": {
      "post": {
        "operationId": "createProject",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ProjectMutationRequest"}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ProjectMutationResponse"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/api/projects/{projectId}/": {
      "get": {
        "operationId": "getProject",
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}],
        "responses": {
          "200": {
            "description": "Project details",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ProjectMutationResponse"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      },
      "patch": {
        "operationId": "updateProject",
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ProjectMutationRequest"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project updated",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ProjectMutationResponse"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "404": {"$ref": "#/components/responses/ApiError"}
        }
      }
    },
    "/api/projects/{projectId}/team/invitations/": {
      "post": {
        "operationId": "createProjectInvitation",
        "parameters": [{"$ref": "#/components/parameters/ProjectId"}],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/ProjectInvitationRequest"}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation created",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ProjectInvitationResponse"}
              }
            }
          },
          "400": {"$ref": "#/components/responses/ApiError"},
          "401": {"$ref": "#/components/responses/ApiError"},
          "403": {"$ref": "#/components/responses/ApiError"},
          "409": {"$ref": "#/components/responses/ApiError"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Token"
      }
    },
    "parameters": {
      "ProjectId": {
        "name": "projectId",
        "in": "path",
        "required": true,
        "schema": {"type": "integer"}
      }
    },
    "responses": {
      "ApiError": {
        "description": "Canonical API error",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ApiErrorEnvelope"}
          }
        }
      }
    },
    "schemas": {
      "ApiErrorDetail": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "fields": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "ApiErrorEnvelope": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {"$ref": "#/components/schemas/ApiErrorDetail"},
          "code": {"type": "string", "deprecated": true},
          "detail": {"type": "string", "deprecated": true},
          "errors": {"type": "object", "additionalProperties": true, "deprecated": true}
        }
      },
      "CharacterTreeNode": {
        "type": "object",
        "required": ["id", "key", "name", "is_folder"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "key": {"type": "string"},
          "name": {"type": "string"},
          "is_folder": {"type": "boolean"},
          "character_id": {"type": "string", "format": "uuid", "nullable": true},
          "legacy_hero_id": {"type": "integer", "nullable": true},
          "children": {
            "type": "array",
            "items": {"$ref": "#/components/schemas/CharacterTreeNode"}
          }
        }
      },
      "CharacterTreeCreateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "projectId"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 255},
          "type": {"type": "string", "enum": ["leaf", "node"]},
          "projectId": {"oneOf": [{"type": "integer"}, {"type": "string"}]},
          "parent": {"type": "string", "format": "uuid", "nullable": true},
          "heroID": {"type": "integer", "nullable": true},
          "studioCharacterId": {"type": "string", "format": "uuid", "nullable": true}
        }
      },
      "CharacterTreeRenameRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string", "minLength": 1, "maxLength": 255}
        }
      },
      "CharacterTreeRenameResponse": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "character_id": {"type": "string", "format": "uuid", "nullable": true}
        }
      },
      "CharacterTreeDeleteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {"id": {"type": "string"}}
      },
      "DeleteResponse": {
        "type": "object",
        "required": ["message"],
        "properties": {"message": {"type": "string"}}
      },
      "PosterGenerateRequest": {
        "type": "object",
        "required": ["prompt", "style", "format"],
        "properties": {
          "prompt": {"type": "string", "minLength": 1, "maxLength": 1000},
          "style": {"type": "string", "enum": ["cinematic", "anime", "dark_fantasy", "realism"]},
          "format": {"type": "string", "enum": ["vertical", "square", "horizontal"]},
          "reference_image_url": {"type": "string"},
          "reference_image_asset_id": {"type": "integer"},
          "image_model": {"type": "string", "maxLength": 128}
        }
      },
      "PosterGenerateMultipartRequest": {
        "allOf": [
          {"$ref": "#/components/schemas/PosterGenerateRequest"},
          {
            "type": "object",
            "properties": {
              "reference_image": {"type": "string", "format": "binary"}
            }
          }
        ]
      },
      "PosterVariant": {
        "type": "object",
        "required": ["id", "imageUrl"],
        "properties": {
          "id": {"type": "integer"},
          "imageUrl": {"type": "string", "format": "uri"}
        }
      },
      "PosterOperationResponse": {
        "type": "object",
        "required": ["variants"],
        "properties": {
          "jobId": {"type": "integer"},
          "status": {"type": "string", "enum": ["queued", "processing", "completed", "failed", "cancelled"]},
          "variants": {"type": "array", "items": {"$ref": "#/components/schemas/PosterVariant"}}
        }
      },
      "ProjectMutationRequest": {
        "type": "object",
        "properties": {
          "title": {"type": "string", "maxLength": 255},
          "format": {"type": "string"},
          "genre": {"type": "array", "items": {"type": "string"}},
          "audience": {"type": "array", "items": {"type": "string"}},
          "annotation": {"type": "string", "maxLength": 800},
          "synopsis": {"type": "string", "maxLength": 2000},
          "status": {"type": "string"},
          "is_favorite": {"type": "boolean"},
          "poster_image_data": {"type": "string"},
          "poster_url": {"type": "string", "nullable": true}
        }
      },
      "ProjectMutationResponse": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": {"type": "integer"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "status": {"type": "string"},
          "statusLabel": {"type": "string"},
          "coverImageUrl": {"type": "string", "nullable": true},
          "updatedAt": {"type": "string", "format": "date-time", "nullable": true},
          "updatedAtLabel": {"type": "string"},
          "isFavorite": {"type": "boolean"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "stats": {"type": "object", "additionalProperties": true},
          "format": {"type": "string"},
          "genre": {"type": "array", "items": {"type": "string"}},
          "audience": {"type": "array", "items": {"type": "string"}},
          "annotation": {"type": "string"},
          "synopsis": {"type": "string"},
          "posterUrl": {"type": "string", "nullable": true},
          "generationSettings": {"type": "object", "additionalProperties": true},
          "createdAt": {"type": "string", "format": "date-time", "nullable": true}
        }
      },
      "ProjectInvitationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invitation_type", "access_role"],
        "properties": {
          "invitation_type": {"type": "string", "enum": ["username", "link"]},
          "username": {"type": "string"},
          "access_role": {"type": "string", "enum": ["admin", "editor", "viewer"]},
          "team_role": {"type": "string"},
          "custom_team_role": {"type": "string"}
        }
      },
      "ProjectInvitationResponse": {
        "type": "object",
        "required": ["id", "invitationType", "accessRole", "status"],
        "properties": {
          "id": {"type": "integer"},
          "invitationType": {"type": "string", "enum": ["username", "link"]},
          "accessRole": {"type": "string", "enum": ["admin", "editor", "viewer"]},
          "accessRoleLabel": {"type": "string"},
          "teamRole": {"type": "string"},
          "teamRoleLabel": {"type": "string"},
          "status": {"type": "string"},
          "invitedUsername": {"type": "string", "nullable": true},
          "invitedByUsername": {"type": "string", "nullable": true},
          "createdAt": {"type": "string", "format": "date-time", "nullable": true},
          "expiresAt": {"type": "string", "format": "date-time", "nullable": true},
          "inviteUrl": {"type": "string", "format": "uri"},
          "token": {"type": "string"}
        }
      }
    }
  }
}