# --- Django core ---
DJANGO_SECRET_KEY=replace-me-with-50+-random-chars
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CRAFT_LOG_LEVEL=INFO
CRAFT_REQUEST_LOG_LEVEL=WARNING
# Break-glass local diagnostics only; raw prompts may contain private user text.
GENERATION_LOG_RAW_PROMPTS=false

# --- Craft credits demo ---
# Development-only balance stub. Keep false in production.
CREDITS_DEMO_TOP_UP_ENABLED=true
CREDITS_LOW_BALANCE_THRESHOLD=1.00
CREDITS_TRANSFER_MAX_AMOUNT=1000.00
CREDITS_TRANSFER_DAILY_LIMIT=2000.00
CREDITS_TRANSFER_DAILY_COUNT_LIMIT=20

# --- CORS ---
CORS_ALLOW_ALL=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (Postgres) ---
W_CRAFT_POSTGRES_ENGINE=django.db.backends.postgresql
W_CRAFT_POSTGRES_DB=w_craft
W_CRAFT_POSTGRES_USER=
W_CRAFT_POSTGRES_PASSWORD=
W_CRAFT_POSTGRES_HOST=127.0.0.1
W_CRAFT_POSTGRES_PORT=5432

# --- Public URL ---
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000

# --- Persistent user uploads (must be outside the source checkout) ---
MEDIA_ROOT=../w_craft_data/media

# --- AI providers ---
TOKEN_HUGGING_FACE=
STABLE_KEY=

# --- Music Studio / pluggable audio generation ---
# Keep `mock` for local deterministic WAV output.
MUSIC_GENERATION_PROVIDER=mock
MUSIC_ALLOW_MOCK=false
# MUSIC_DEFAULT_AUDIO_MODEL=lyria-3-pro
MUSIC_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
MUSIC_GEMINI_TIMEOUT_SECONDS=180
MUSIC_GEMINI_RESPONSE_DEADLINE_SECONDS=300
MUSIC_OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
MUSIC_OPENROUTER_TIMEOUT_SECONDS=180
MUSIC_OPENROUTER_RESPONSE_DEADLINE_SECONDS=300
# Must exceed the longest synchronous provider timeout with operational margin.
MUSIC_JOB_LEASE_SECONDS=300
STABILITY_API_KEY=
MUSIC_STABILITY_API_BASE_URL=https://api.stability.ai
MUSIC_STABILITY_MODEL=stable-audio-3
MUSIC_STABILITY_OUTPUT_FORMAT=mp3
MUSIC_STABILITY_TIMEOUT_SECONDS=30
MUSIC_STABILITY_POLL_SECONDS=10
MUSIC_STABILITY_MAX_POLL_SECONDS=1800
# Stable Audio 3.0 is currently 26 provider credits ($0.26) per successful result.
MUSIC_STABILITY_COST_USD_PER_VARIANT=0.26

# --- Character Studio / Gemini ---
CHARACTER_STUDIO_IMAGE_PROVIDER=mock
CHARACTER_STUDIO_PROVIDER_TIMEOUT_SECONDS=120
CHARACTER_STUDIO_MAX_ACTIVE_GLOBAL=4
CHARACTER_STUDIO_MAX_ACTIVE_PER_PROJECT=2
CHARACTER_STUDIO_DAILY_BUDGET_PER_USER=50
CHARACTER_STUDIO_DAILY_BUDGET_PER_PROJECT=100
CHARACTER_STUDIO_ESTIMATED_COST_USD_PER_CALL=
SIGNED_MEDIA_BASE_URL=
SIGNED_MEDIA_TTL_SECONDS=300
MEDIA_ORPHAN_RETENTION_HOURS=168
MEDIA_REMOTE_FETCH_ALLOW_HTTP=false
IMAGE_PROVIDER_FETCH_TIMEOUT_SECONDS=15
IMAGE_PROVIDER_MAX_OUTPUT_BYTES=20971520
IMAGE_PROVIDER_MAX_OUTPUT_PIXELS=20000000
REFERENCE_IMAGE_PROVIDER=mock
# Allow the deterministic reference provider in production only for explicit diagnostics.
REFERENCE_ALLOW_MOCK=false
REFERENCE_PROVIDER_TIMEOUT_SECONDS=90
# 3D reconstruction runs outside the Django environment.
MODEL3D_CONDA_ENV=basic
# MODEL3D_CONDA_EXE=C:\Users\you\miniconda3\Scripts\conda.exe
# MODEL3D_RECONSTRUCTION_PYTHON=C:\path\to\dedicated\python.exe
READINESS_REQUIRE_MODEL3D_WORKER=true
GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
GEMINI_SAFETY_FILTER_LEVEL=block_few

# --- Poster generator provider (gemini) ---
POSTER_IMAGE_PROVIDER=gemini
# GEMINI_POSTER_MODEL=imagen-4.0-generate-001

# --- Pluggable image generation (LiteLLM + direct OpenRouter Images) ---
# Registry key from MODEL_REGISTRY used when a user has no preference set.
# Known keys: gemini-imagen-4, gemini-flash-image, openrouter-flash-image, gemini-native
# Discovered direct-image keys use openrouter-images:<provider/model>.
DEFAULT_IMAGE_MODEL=gemini-flash-image
# Needed for the openrouter-* registry entries.
OPENROUTER_API_KEY=
# Direct Images API base; keep /api/v1 unless using a compatible gateway.
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter app attribution headers (never put secrets here).
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
# Needed for OpenAI/DALL-E entries when you add them to the registry.
OPENAI_API_KEY=
